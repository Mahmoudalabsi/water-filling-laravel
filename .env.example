APP_NAME="تعبئة المياه"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

# Render will provide DATABASE_URL in 'postgresql://user:pass@host:port/db' format.
# We auto-detect postgres in config/database.php.
DB_CONNECTION=pgsql
DATABASE_URL=

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Render's PORT env var
PORT=8000
