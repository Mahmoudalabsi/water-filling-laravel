APP_NAME="Water Filling App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://water-filling-laravel.onrender.com

# Two modes:
#   1. SQLite (default for free tier without a DB):
#      - leave DATABASE_URL empty
#      - DB_CONNECTION=sqlite
#      - DB_DATABASE=/data/database.sqlite (Render mounts this as persistent disk)
#   2. PostgreSQL/MySQL (set DATABASE_URL from Render's DB):
#      - DATABASE_URL=postgresql://user:pass@host:port/dbname
#      - We auto-detect pgsql/mysql from URL scheme.
DB_CONNECTION=sqlite
DATABASE_URL=
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Render sets PORT automatically
PORT=8000
